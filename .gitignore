# dependencies and tool state
node_modules/
.wrangler/
# scratch work: captures, tool pictures, clips in progress (never committed)
scratch/
# your private profile: ideas, requests about Pixel Yak itself, your own design files, brand (a separate private repo, if you like)
local/
# games are their own repos, cloned into games/ — the demo too: it ships in templates/demo/ and is
# installed into games/ (node cli/yak.mjs demo), so the person's work on it never meets an update
games/*
# capture-test output (tools/run-captures.mjs) and rendered clips (tools/clip.cjs)
games/*/dev/out/
games/*/clips/out/
# logs
*.log
# agent worktrees (Claude Code)
.claude/worktrees/
# parallel agent worktrees
.worktrees/
