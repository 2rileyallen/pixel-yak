{
  "name": "pixel-yak",
  "version": "0.1.0",
  "description": "A pixel-art game studio you run with your AI: the AI writes the games (art, music and code are all code), you play, paint over the art, tune the music and say what you think.",
  "main": "studio/main/main.mjs",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "yak": "node cli/yak.mjs",
    "web": "node tools/server.js",
    "test": "node --test \"tests/**/*.test.mjs\" \"designs/systems/**/*.test.mjs\"",
    "sync-skills": "node tools/sync-skills.mjs"
  },
  "keywords": ["pixel-art", "game-engine", "ai", "harness", "electron", "procedural-art"],
  "license": "MIT",
  "devDependencies": {
    "electron": "44.9.0"
  }
}
